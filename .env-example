# Environment variables for database connection, secret key, and OpenAI API key

# to update database using alembic needs to use this connection
# DATABASE_URL=

DATABASE_URL=
SECRET_KEY=
OPENAI_API_KEY=
# For free transcription via Groq (OpenAI-compatible), set this instead:
GROQ_API_KEY=
# Choose: "openai" (paid) or "groq" (free). Defaults to openai if GROQ_API_KEY is not set.
AI_PROVIDER=
